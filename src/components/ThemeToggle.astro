---
// A light/dark theme toggle in the top-right corner. Uses absolute (not fixed)
// positioning so it stays put and scrolls away with the page rather than
// floating over content. The initial theme is applied before paint by the
// inline script in BaseHead.astro; this button flips it and persists the choice.
---

<button id="theme-toggle" type="button" aria-label="Toggle color theme">
	<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path
			fill="currentColor"
			d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 17a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1ZM4.2 4.2a1 1 0 0 1 1.4 0l.8.7A1 1 0 1 1 5 6.4l-.8-.8a1 1 0 0 1 0-1.4Zm12.6 12.6a1 1 0 0 1 1.4 0l.8.8a1 1 0 0 1-1.4 1.4l-.8-.8a1 1 0 0 1 0-1.4ZM2 12a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1Zm17 0a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1ZM4.2 19.8a1 1 0 0 1 0-1.4l.8-.8A1 1 0 0 1 6.4 19l-.8.8a1 1 0 0 1-1.4 0ZM16.8 7.2a1 1 0 0 1 0-1.4l.8-.8a1 1 0 1 1 1.4 1.4l-.8.8a1 1 0 0 1-1.4 0Z"
		></path>
	</svg>
	<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path
			fill="currentColor"
			d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
		></path>
	</svg>
</button>

<style>
	#theme-toggle {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 50;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: 8px;
		color: var(--muted);
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	#theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	#theme-toggle .moon {
		display: none;
	}
	:global([data-theme='dark']) #theme-toggle .sun {
		display: none;
	}
	:global([data-theme='dark']) #theme-toggle .moon {
		display: inline;
	}
</style>

<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const next =
			document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
