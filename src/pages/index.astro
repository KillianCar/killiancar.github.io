---
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_DESCRIPTION, SITE_HEADING, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin: 0 0 0.35rem;
			}
			.subtitle {
				margin: 0 0 1.75rem;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--muted);
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				column-gap: 1rem;
				align-items: baseline;
				/* No left indent: titles align flush with the heading. The hover
				   accent uses an absolutely-positioned bar in the left margin so
				   it doesn't push the text inward. */
				padding: 0.7rem 0;
				border-top: 1px solid var(--rule);
			}
			.post::before {
				content: '';
				position: absolute;
				left: -0.85rem;
				top: 0;
				bottom: 0;
				width: 2px;
				background: transparent;
				transition: background-color 0.18s ease;
			}
			@media (hover: hover) {
				.post:hover::before {
					background: var(--accent);
				}
			}
			.post-title {
				grid-column: 1;
				grid-row: 1;
				font-size: 1.05rem;
				font-weight: 600;
				letter-spacing: -0.01em;
				line-height: 1.3;
				margin: 0;
			}
			.post-title a {
				color: var(--fg);
				text-decoration: none;
			}
			/* Stretch the title link to cover the whole card, so the entire
			   row is clickable while keeping a single semantic link. */
			.post-title a::after {
				content: '';
				position: absolute;
				inset: 0;
			}
			@media (hover: hover) {
				.post:hover .post-title a {
					color: var(--accent);
				}
			}
			.post-date {
				grid-column: 2;
				grid-row: 1;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--muted);
			}
			.post-excerpt {
				grid-column: 1 / -1;
				grid-row: 2;
				margin: 0.15rem 0 0;
				font-size: 0.85rem;
				line-height: 1.45;
				color: var(--muted);
			}
			.site-footer {
				margin-top: 2.5rem;
				display: flex;
				justify-content: flex-end;
			}
			.social-link {
				display: inline-flex;
				color: var(--muted);
				transition: color 0.18s ease;
			}
			.social-link:hover {
				color: var(--accent);
			}
			.social-link svg {
				width: 1.4rem;
				height: 1.4rem;
				fill: currentColor;
			}
		</style>
	</head>
	<body>
		<ThemeToggle />
		<main>
			<h1 class="intro">{SITE_HEADING}</h1>
			<p class="subtitle">Builder, Head of Product Engineering @ Jentic</p>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post">
							<h2 class="post-title">
								<a href={`/${post.id}/`}>{post.data.title}</a>
							</h2>
							<span class="post-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							{post.data.description && (
								<p class="post-excerpt">{post.data.description}</p>
							)}
						</li>
					))
				}
			</ul>
			<footer class="site-footer">
				<a
					class="social-link"
					href="https://www.linkedin.com/in/killian-carroll/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
						></path>
					</svg>
				</a>
			</footer>
		</main>
	</body>
</html>
