---
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_DESCRIPTION, SITE_HEADING, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin: 0 0 1.75rem;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				column-gap: 1rem;
				align-items: baseline;
				padding: 0.7rem 0 0.7rem 0.85rem;
				border-top: 1px solid var(--rule);
				border-left: 2px solid transparent;
				transition: border-color 0.18s ease;
			}
			.post:hover {
				border-left-color: var(--accent);
			}
			.post-title {
				grid-column: 1;
				grid-row: 1;
				font-size: 1.05rem;
				font-weight: 600;
				letter-spacing: -0.01em;
				line-height: 1.3;
				margin: 0;
			}
			.post-title a {
				color: var(--fg);
				text-decoration: none;
			}
			/* Stretch the title link to cover the whole card, so the entire
			   row is clickable while keeping a single semantic link. */
			.post-title a::after {
				content: '';
				position: absolute;
				inset: 0;
			}
			.post:hover .post-title a {
				color: var(--accent);
			}
			.post-date {
				grid-column: 2;
				grid-row: 1;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--muted);
			}
			.post-excerpt {
				grid-column: 1 / -1;
				grid-row: 2;
				margin: 0.15rem 0 0;
				font-size: 0.85rem;
				line-height: 1.45;
				color: var(--muted);
			}
		</style>
	</head>
	<body>
		<ThemeToggle />
		<main>
			<h1 class="intro">{SITE_HEADING}</h1>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post">
							<h2 class="post-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h2>
							<span class="post-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							{post.data.description && (
								<p class="post-excerpt">{post.data.description}</p>
							)}
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>
